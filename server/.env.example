# Server environment variables (example)
# Copy this file to `.env` and replace values

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/jmshoes

# JWT secrets (use strong random values in production, e.g. `openssl rand -base64 48`)
JWT_SECRET=replace-with-strong-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-strong-secret-min-32-chars

# Server port
PORT=3001
