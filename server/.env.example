# =============================================================================
# JM Shoes - Server environment
# Copy this file to `.env` and replace the values. NEVER commit the real .env.
# =============================================================================

# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Database
# -----------------------------------------------------------------------------
# Connection string for PostgreSQL 14+
DATABASE_URL=postgresql://user:password@localhost:5432/jmshoes

# Optional: pool size
# PG_POOL_MAX=10

# Auth (JWT)
# -----------------------------------------------------------------------------
# Generate strong values with: `openssl rand -base64 48`
# The server will REFUSE to boot if these are missing, weak, or look like the
# placeholders below.
JWT_SECRET=replace-with-strong-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-strong-secret-min-32-chars

# CORS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins. Required in production.
# Local dev: http://localhost:5173
# Production: https://your-domain.com
CORS_ORIGIN=http://localhost:5173

# Public URL (used by the sitemap)
# -----------------------------------------------------------------------------
# Optional: absolute base URL used to build sitemap entries. Falls back to the
# request host if not set.
# PUBLIC_BASE_URL=https://your-domain.com
