{
  "name": "jm-shoes",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo root for JM Shoes (cliente + server).",
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node scripts/dev.js",
    "dev:server": "npm --prefix server run dev",
    "dev:cliente": "npm --prefix cliente run dev",
    "build": "npm --prefix cliente run build",
    "lint": "npm --prefix cliente run lint",
    "test": "npm --prefix server test"
  }
}
